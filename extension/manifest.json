{
  "manifest_version": 3,
  "name": "Krypton — NCERT Study Buddy",
  "short_name": "Krypton",
  "version": "1.0.0",
  "description": "Explain, flashcards, quizzes and CBSE papers from NCERT books (Classes 1–10) — and a focus lock that stops endless scrolling.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Krypton",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "tabs", "alarms", "notifications"],
  "host_permissions": ["http://127.0.0.1:8765/*", "http://localhost:8765/*", "https://*.onrender.com/*", "https://*.trycloudflare.com/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
